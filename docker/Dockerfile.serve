# Slim CPU inference image.
# Build:  docker build -f docker/Dockerfile.serve -t <user>/mltemplate-serve .
# Run:    docker run -p 8000:8000 -v $(pwd)/outputs/demo/checkpoints:/models \
#           -e CHECKPOINT_PATH=/models/best.pt <user>/mltemplate-serve
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    CHECKPOINT_PATH=/models/best.pt

WORKDIR /app

# CPU-only PyTorch wheel: much smaller than the default CUDA build.
RUN pip install torch --index-url https://download.pytorch.org/whl/cpu

COPY pyproject.toml README.md ./
COPY src ./src
RUN pip install ".[serve]"

COPY app ./app

EXPOSE 8000
CMD ["uvicorn", "app.serve:app", "--host", "0.0.0.0", "--port", "8000"]
